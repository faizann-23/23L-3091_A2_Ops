# VisionGuard environment template.
# Copy to .env (cp .env.example .env) and fill in real values. .env is git-ignored.

# ---- Flask ----
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change_me_to_a_long_random_string
MAX_FILE_SIZE_MB=5

# ---- Model inference ----
MODEL_PATH=champion_mobilenetv2_best.keras
MODEL_NAME=champion_mobilenetv2
THRESHOLD=0.5

# ---- Database ----
# Local `python app.py` runs use SQLite (DB_BACKEND=sqlite, file below).
# docker-compose.yml forces DB_BACKEND=postgres for the web container by itself.
DB_BACKEND=sqlite
DATABASE_PATH=visionguard.db

# Used by Docker Compose (PostgreSQL service "db"). Pick a strong password.
DB_USER=visionuser
DB_PASSWORD=change_me_strong_password
DB_NAME=visionguard_db
DB_HOST=db
DB_PORT=5432

# ---- DagsHub / MLflow (training + registry scripts only, never needed by the web app) ----
DAGSHUB_REPO_OWNER=faizann-23
DAGSHUB_REPO_NAME=23L-3091_A2_Ops
MLFLOW_TRACKING_URI=https://dagshub.com/faizann-23/23L-3091_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=faizann-23
DAGSHUB_USER_TOKEN=your_dagshub_token_here
